# Database
# For Codespaces: use @db:5432 (devcontainer service)
# For local dev: change to @localhost:5432 or your PostgreSQL host
DATABASE_URL="postgresql://postgres:postgres@db:5432/photext"

# NextAuth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GITHUB_ID=""
GITHUB_SECRET=""

# Email Provider (optional)
EMAIL_SERVER=""
EMAIL_FROM=""

# AI Provider (optional - if not set, mock provider will be used)
OPENAI_API_KEY=""
